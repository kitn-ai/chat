{
  "name": "@kitn.ai/docs",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "nx": { "name": "docs" },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "predev": "node scripts/copy-kit-assets.mjs && node scripts/copy-blocks.mjs",
    "prebuild": "node scripts/copy-kit-assets.mjs && node scripts/copy-blocks.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "verify:docs": "node scripts/docs-alignment/index.mjs",
    "verify:docs:report": "node scripts/docs-alignment/index.mjs --report-only --report docs/superpowers/specs/2026-08-10-docs-code-alignment.md",
    "verify:preview": "node scripts/verify-preview-source.mjs",
    "pretest": "node scripts/copy-blocks.mjs",
    "test": "vitest run",
    "pretypecheck:blocks": "node scripts/copy-blocks.mjs",
    "typecheck:blocks": "tsc --noEmit -p tsconfig.blocks.json"
  },
  "dependencies": {
    "@astrojs/solid-js": "^6.0.1",
    "@astrojs/starlight": "^0.40.0",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@iconify-json/lucide": "^1.2.113",
    "@kitn.ai/blocks": "workspace:*",
    "@kitn.ai/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^6.4.5",
    "astro-icon": "^1.1.5",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "sharp": "^0.34.5",
    "solid-js": "^1.9.13",
    "starlight-sidebar-topics": "^0.8.0",
    "tailwindcss": "^4.3.1",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/simple-icons": "^1.2.86",
    "@iconify/utils": "^3.1.3",
    "@solidjs/testing-library": "^0.8.10",
    "@types/node": "^26.0.0",
    "jsdom": "^24.1.3",
    "typescript": "^5.5.0",
    "unplugin-icons": "^23.0.1",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.2"
  }
}
