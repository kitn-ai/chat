---
// Full header override — total control of layout (Starlight's default fought
// every CSS attempt to right-align the search). Left: logo + nav. Right:
// search + GitHub + Ask AI + theme toggle.
//
// The nav is NOT a list of its own: it renders src/topics.mjs, the same array
// astro.config.mjs hands to starlight-sidebar-topics. Add a topic there and it
// appears here and in the sidebar switcher together.
//
// One menu button, and only where nothing else provides one. Starlight's
// PageFrame renders <MobileMenuToggle /> as the sibling right before
// #starlight__sidebar, and its drawer opens off `[aria-expanded='true'] ~
// .sidebar-pane`, but it renders that whole <nav> only when `hasSidebar`. So a
// sidebar-less page (the landing page, template: splash) has no drawer at all,
// and below the nav breakpoint it had no navigation either: logo and search,
// with Docs, Components, Patterns, Examples, Integrations, Theme and Storybook
// unreachable. The disclosure below fills exactly that gap and is gated on the
// same `hasSidebar` flag PageFrame reads, so the two can never both appear.
// A header copy of the button on a page that DOES have a drawer is the bug this
// gate exists to avoid: it sat underneath the real one and, having no
// .sidebar-pane next to it, set body[data-mobile-menu-expanded] (which locks
// scrolling) while opening nothing.
import Search from '@astrojs/starlight/components/Search.astro';
import SocialIcons from './SocialIcons.astro';
import ThemeToggle from './ThemeToggle.astro';
import { Icon } from 'astro-icon/components';
import { topics } from '../../topics.mjs';

// BASE_URL is '/' (root); strip any trailing slash so asset/nav URLs are always '/…'.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}/${p.replace(/^\//, '')}`;
const logo = href('kitn-logo.png');
// A topic's link is either a site path or a full external URL (Storybook).
const linkTo = (t: (typeof topics)[number]) => (/^https?:\/\//.test(t.link) ? t.link : href(t.link));
// Topics carrying a `headerIcon` (Theme, Storybook) are tools rather than
// sections, so they sit after a divider with their icon.
const sections = topics.filter((t) => !('headerIcon' in t));
const tools = topics.filter((t) => 'headerIcon' in t);
// The same flag PageFrame gates its drawer on. False on the splash template.
const { hasSidebar } = Astro.locals.starlightRoute;
---
<div class="flex h-full w-full items-center gap-4">
  <a href={`${base}/`} class="flex shrink-0 items-center gap-2 no-underline">
    <img src={logo} alt="kitn" width="26" height="24" class="kai-logo-img h-6 w-[26px] shrink-0" />
    <span class="whitespace-nowrap text-xl font-black tracking-tight"><span class="text-ink">AI</span><span class="text-brand">/</span><span class="text-ink">UI</span></span>
  </a>
  {/* `nav:` is the measured width the whole row stops fitting at, not a stock
      Tailwind step — see --breakpoint-nav in app.css. Below it the sidebar's
      topic switcher is the navigation. */}
  <nav class="ml-5 hidden items-center gap-5 nav:flex" aria-label="Primary">
    {sections.map((t) => (
      <a href={linkTo(t)} {...t.attrs} class="whitespace-nowrap text-sm font-semibold text-ink-2 no-underline transition-colors hover:text-ink">{t.label}</a>
    ))}
    {tools.length > 0 && <span class="text-ink-3" aria-hidden="true">|</span>}
    {tools.map((t) => (
      <a href={linkTo(t)} {...t.attrs} class="flex items-center gap-1.5 whitespace-nowrap text-sm font-semibold text-ink-2 no-underline transition-colors hover:text-ink">
        <Icon name={t.headerIcon} class="size-4 shrink-0" />
        <span>{t.label}</span>
      </a>
    ))}
  </nav>

  <div class="ml-auto flex items-center gap-3">
    <div class="kai-search"><Search /></div>
    {/* `chrome:` is Starlight's own 50rem mobile line: below it these two move
        into the drawer's MobileMenuFooter, which is hidden at exactly 50rem. */}
    <div class="hidden items-center gap-3 chrome:flex"><SocialIcons /><ThemeToggle /></div>
    {!hasSidebar && (
      <details class="kai-topics-menu relative nav:hidden" data-topics-menu>
        <summary
          class="flex size-8 cursor-pointer list-none items-center justify-center rounded-md text-ink transition-colors hover:bg-surface-2"
          aria-label="Menu"
        >
          <Icon name="lucide:menu" class="size-5 shrink-0" />
        </summary>
        {/* Anchored to the header row, so it drops just under the header bar. */}
        <div class="absolute end-0 top-[calc(100%+0.75rem)] w-56 rounded-lg border border-line bg-surface p-2 shadow-lg">
          {/* Same list, same order and same treatment as the sidebar drawer's
              topic switcher: plain text for the sections, an outlined icon for
              the tools. */}
          <ul class="m-0 list-none p-0">
            {sections.map((t) => (
              <li>
                <a href={linkTo(t)} {...t.attrs} class="flex items-center gap-2 rounded-md px-2 py-[0.3em] text-base font-semibold text-ink no-underline hover:text-brand">{t.label}</a>
              </li>
            ))}
            {tools.length > 0 && <li aria-hidden="true"><hr class="my-2 border-0 border-t border-line" /></li>}
            {tools.map((t) => (
              <li>
                <a href={linkTo(t)} {...t.attrs} class="flex items-center gap-2 rounded-md px-2 py-[0.3em] text-base font-semibold text-ink no-underline hover:text-brand">
                  <span class="flex items-center justify-center rounded border border-line p-1"><Icon name={t.headerIcon} class="size-4 shrink-0" /></span>
                  <span>{t.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>
    )}
  </div>
</div>

<style>
  /* Safari still paints a disclosure triangle without this. */
  .kai-topics-menu > summary::-webkit-details-marker { display: none; }
</style>

<script>
  // Close on Escape and on a click outside. No scroll lock: the panel is a
  // short list of topic links and the page behind it does not need freezing.
  const menu = document.querySelector<HTMLDetailsElement>('[data-topics-menu]');
  if (menu) {
    const summary = menu.querySelector('summary');
    document.addEventListener('click', (event) => {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !menu.open) return;
      menu.open = false;
      summary?.focus();
    });
  }
</script>
