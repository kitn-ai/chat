node_modules/
dist/
storybook-static/
# One-off coverage diagnostic output (`--coverage`); never produced in CI.
coverage/
packages/ui/src/elements/compiled.css
*.log
.DS_Store

# Brainstorming visual companion
.superpowers/

# Throwaway agent git worktrees (full repo copies)
.claude/worktrees/
test-results/

# composer pill-skin visual captures (dev artifacts, regenerated by *.shot.spec.ts)
packages/ui/tests/e2e/__screenshots__/pill-skins/

# IVP screenshots (non-deterministic, regenerated on each run)
spike-screens/

# Screenshot helper that drives the IVP loop above: a throwaway Playwright script
# (`node _shot.mjs <url> <out> [mode] [w] [h] [selector]`). Deliberately NOT
# committed — agents recreate it per worktree from the snippet in
# docs/superpowers/HANDOFF-composition-hardening.md §5. Ignored so it stops
# dirtying `git status`, which is what trains people to ignore a dirty tree.
/_shot.mjs

# Emitted-scaffold module the live card test writes, imports and runs
# (rewritten per run by emitted-card-path.live.test.ts; only survives a crash)
packages/ui/.tmp-emitted-scaffold/

# NX local cache
.nx/cache
.nx/workspace-data
