{
  "name": "@kitn.ai/devtools",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "The kai devtools panel: a zero-dependency web component that shows what the @kitn.ai/ui wire adapter saw.",
  "license": "MIT",
  "main": "./dist/kai-devtools.es.js",
  "unpkg": "./dist/kai-devtools.es.js",
  "jsdelivr": "./dist/kai-devtools.es.js",
  "exports": {
    ".": "./dist/kai-devtools.es.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "scripts": {
    "prebuild": "npm run build:css",
    "build": "vite build",
    "build:css": "tailwindcss -i src/styles.css -o src/compiled.css --minify",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:imports": "node scripts/verify-no-bare-imports.mjs",
    "demo": "vite dev --config vite.config.demo.ts"
  },
  "devDependencies": {
    "@kitn.ai/ui": "workspace:*",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "jsdom": "^24.0.0",
    "solid-js": "^1.9.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.1.0"
  }
}
