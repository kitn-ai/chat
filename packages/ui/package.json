{
  "name": "@kitn.ai/ui",
  "version": "0.31.0",
  "nx": {
    "name": "ui",
    "targets": {
      "build-storybook": {
        "dependsOn": [
          "build"
        ]
      },
      "dev": {
        "dependsOn": [
          "build"
        ]
      },
      "test:storybook": {
        "dependsOn": [
          "build"
        ]
      },
      "test:storybook:ci": {
        "dependsOn": [
          "build"
        ]
      }
    }
  },
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/kai.es.js",
    "./dist/register-impl-*.js",
    "./dist/elements/*.js"
  ],
  "description": "Framework-agnostic, Shadow-DOM web components for building AI chat interfaces — works in React, Vue, Angular, Svelte, or plain HTML. Authored in SolidJS.",
  "keywords": [
    "web-components",
    "custom-elements",
    "shadow-dom",
    "ai",
    "chat",
    "chatbot",
    "llm",
    "chat-ui",
    "streaming",
    "markdown",
    "framework-agnostic",
    "react",
    "vue",
    "angular",
    "svelte",
    "solid-js"
  ],
  "license": "MIT",
  "homepage": "https://ui.kitn.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitn-ai/ui.git"
  },
  "bugs": {
    "url": "https://github.com/kitn-ai/ui/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/kai.es.js",
  "jsdelivr": "./dist/kai.es.js",
  "customElements": "dist/custom-elements.json",
  "bin": {
    "kai-mcp": "./bin/mcp.js",
    "kai": "./bin/mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "worker": "./dist/index.server.js",
      "browser": "./dist/index.js",
      "deno": "./dist/index.server.js",
      "node": "./dist/index.server.js",
      "default": "./dist/index.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "default": "./dist/kai.es.js"
    },
    "./elements/*": {
      "types": "./dist/elements/*.d.ts",
      "default": "./dist/elements/*.js"
    },
    "./autoloader": {
      "types": "./dist/elements/autoloader.d.ts",
      "default": "./dist/elements/autoloader.js"
    },
    "./theme.css": "./theme.css",
    "./solid.css": "./solid.css",
    "./theme.tokens.css": "./dist/theme.tokens.css",
    "./element-meta.json": "./src/elements/element-meta.json",
    "./icon-names.json": "./src/elements/icon-names.json",
    "./package.json": "./package.json",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "worker": "./dist/solid.server.js",
      "browser": "./dist/solid.js",
      "deno": "./dist/solid.server.js",
      "node": "./dist/solid.server.js",
      "default": "./dist/solid.js"
    },
    "./state": {
      "types": "./dist/state/index.d.ts",
      "default": "./dist/state.js"
    },
    "./wire": {
      "types": "./dist/wire/index.d.ts",
      "default": "./dist/wire.js"
    },
    "./stores": {
      "types": "./dist/stores/index.d.ts",
      "default": "./dist/stores.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "worker": "./dist/define.server.js",
      "browser": "./dist/define.js",
      "deno": "./dist/define.server.js",
      "node": "./dist/define.server.js",
      "default": "./dist/define.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics/index.d.ts",
      "default": "./dist/diagnostics.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "default": "./dist/schemas.js"
    },
    "./schemas/*": "./dist/schemas/*",
    "./construct": {
      "types": "./dist/agent-tooling/construct/public.d.ts",
      "default": "./dist/construct.js"
    },
    "./construct/templates": {
      "types": "./dist/agent-tooling/construct/templates.d.ts",
      "default": "./dist/construct-templates.js"
    },
    "./provider": {
      "types": "./dist/remote/provider.d.ts",
      "default": "./dist/kai-provider.es.js"
    }
  },
  "typesVersions": {
    "*": {
      "schemas": [
        "./dist/schemas/index.d.ts"
      ],
      "construct": [
        "./dist/agent-tooling/construct/public.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src/elements/element-meta.json",
    "src/elements/icon-names.json",
    "bin",
    "!bin/**/*.test.js",
    "!dist/**/*.testlib.*",
    "frameworks",
    "theme.css",
    "solid.css",
    "kit-base.css",
    "llms.txt",
    "llms-full.txt",
    "NOTICE"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "prebuild": "npm run build:css && npm run build:card-validation",
    "build": "vite build --config vite.config.ts && vite build --config vite.config.provider.ts && vite build --config vite.config.react.ts && vite build --config vite.config.barrel.ts && vite build --config vite.config.barrel.server.ts && vite build --config vite.config.solid.ts && vite build --config vite.config.solid.server.ts && vite build --config vite.config.state.ts && vite build --config vite.config.wire.ts && vite build --config vite.config.stores.ts && vite build --config vite.config.define.ts && vite build --config vite.config.define.server.ts && vite build --config vite.config.diagnostics.ts && vite build --config vite.config.schemas.ts && vite build --config vite.config.mcp.ts && vite build --config vite.config.construct-cli.ts && vite build --config vite.config.construct.ts && vite build --config vite.config.construct-templates.ts && vite build --config vite.config.builder-page.ts && vite build --config vite.config.theme-studio.ts && vite build --config vite.config.gallery.ts && npm run build:elements && npm run dedupe:shiki && npm run verify:elements-bundle && npm run verify:react-wrappers && npm run verify:shader-lazy",
    "build:elements": "node scripts/gen-elements-manifest.mjs && vite build --config vite.config.elements.ts && node scripts/gen-element-dts.mjs",
    "postbuild": "npm run build:theme && npm run build:api && npm run build:blocks && npm run build:schemas && npm run build:subpath-dts && npm run verify:dts && npm run verify:cdn-entries",
    "build:theme": "node scripts/build-theme-tokens.mjs",
    "build:api": "node scripts/gen-elements-manifest.mjs && node scripts/gen-element-api.mjs && node scripts/gen-element-nonscalar.mjs && node scripts/gen-catalog.mjs && node scripts/gen-construct-schema.mjs && node scripts/gen-construct-template-fixtures.mjs",
    "build:schemas": "node scripts/copy-card-schemas.mjs",
    "build:blocks": "node scripts/gen-blocks.mjs",
    "build:card-validation": "node scripts/gen-card-validation-schemas.mjs",
    "build:subpath-dts": "node scripts/emit-subpath-dts.mjs",
    "verify:card-validation": "node scripts/gen-card-validation-schemas.mjs --self-test && node scripts/gen-card-validation-schemas.mjs --check",
    "verify:cdn-entries": "node scripts/verify-cdn-entries.mjs --self-test && node scripts/verify-cdn-entries.mjs",
    "verify:consumer": "node scripts/verify-consumer-sideeffects.mjs",
    "verify:construct": "node scripts/verify-construct.mjs --self-test && node scripts/verify-construct.mjs",
    "verify:dts": "node scripts/verify-dts-boundaries.mjs --self-test && node scripts/verify-dts-boundaries.mjs",
    "verify:elements-bundle": "node scripts/verify-elements-bundle.mjs --self-test && node scripts/verify-elements-bundle.mjs",
    "verify:fresh": "node scripts/verify-artifact-fresh.mjs --self-test && node scripts/verify-artifact-fresh.mjs",
    "verify:dts:consumer": "node scripts/verify-dts-consumer.mjs",
    "verify:generated": "node scripts/verify-generated-sync.mjs --self-test && node scripts/verify-generated-sync.mjs",
    "verify:quarantine": "node scripts/verify-quarantine.mjs --self-test && node scripts/verify-quarantine.mjs",
    "verify:react-wrappers": "node scripts/verify-react-wrappers.mjs --self-test && node scripts/verify-react-wrappers.mjs",
    "verify:scaffold": "node scripts/verify-scaffold-compiles.mjs",
    "verify:blocks": "node scripts/verify-blocks.mjs --self-test && node scripts/verify-blocks.mjs",
    "gate:compiles": "node scripts/acceptance-gate-compiles.mjs",
    "gate:compiles:self-test": "node scripts/acceptance-gate-compiles.mjs --self-test",
    "verify:schemas": "node scripts/verify-schemas-exported.mjs --self-test && node scripts/verify-schemas-exported.mjs",
    "verify:shader-lazy": "node scripts/verify-shader-lazy.mjs --self-test && node scripts/verify-shader-lazy.mjs",
    "dedupe:shiki": "node scripts/dedupe-shiki-chunks.mjs --self-test && node scripts/dedupe-shiki-chunks.mjs",
    "verify:solid-coverage": "node scripts/verify-solid-coverage.mjs --self-test && node scripts/verify-solid-coverage.mjs",
    "verify:tool-schemas": "node scripts/verify-tool-schemas.mjs",
    "verify:ssr": "node scripts/verify-ssr-imports.mjs && node scripts/verify-ssr-render.mjs",
    "verify:diagnostics-wiring": "node scripts/verify-diagnostics-wiring.mjs",
    "verify:ssr:imports": "node scripts/verify-ssr-imports.mjs",
    "verify:ssr:render": "node scripts/verify-ssr-render.mjs",
    "verify:pack": "node scripts/verify-pack-weight.mjs --self-test && node scripts/verify-pack-weight.mjs",
    "verify:starters": "node scripts/verify-starters.mjs",
    "lint:attachment-object-urls": "node scripts/lint-attachment-object-urls.mjs --self-test && node scripts/lint-attachment-object-urls.mjs",
    "lint:cdn-pins": "node scripts/lint-cdn-pins.mjs --self-test && node scripts/lint-cdn-pins.mjs --check-release-wiring && node scripts/lint-cdn-pins.mjs",
    "lint:llms-size": "node scripts/lint-llms-size.mjs --self-test && node scripts/lint-llms-size.mjs",
    "lint:pack-parse": "node scripts/lint-pack-json-parse.mjs --self-test && node scripts/lint-pack-json-parse.mjs",
    "fix:cdn-pins": "node scripts/lint-cdn-pins.mjs --fix",
    "lint:silent-drops": "node scripts/lint-silent-drops.mjs --self-test && node scripts/lint-silent-drops.mjs",
    "lint:catalog-drift": "node scripts/lint-catalog-drift.mjs --self-test && node scripts/lint-catalog-drift.mjs",
    "lint:gate-parity": "node scripts/lint-gate-parity.mjs --self-test && node scripts/lint-gate-parity.mjs",
    "lint:thresholds": "node scripts/lint-threshold-derivation.mjs --self-test && node scripts/lint-threshold-derivation.mjs",
    "lint:story-conventions": "node scripts/lint-story-conventions.mjs --self-test && node scripts/lint-story-conventions.mjs",
    "test": "vitest run",
    "test:react": "vitest run --config vitest.react.config.ts",
    "test:storybook": "vitest run --project=storybook",
    "test:storybook:ci": "node scripts/run-storybook-tests.mjs",
    "test:watch": "vitest",
    "typecheck": "npm run verify:quarantine && tsc --noEmit && tsc --noEmit -p tsconfig.react.json && tsc --noEmit -p tsconfig.react.test.json && tsc --noEmit -p tsconfig.apps.json && tsc --noEmit -p tsconfig.mcp.json && tsc --noEmit -p tsconfig.tests.json",
    "examples": "echo 'Serving repo root on http://localhost:8000 — open http://localhost:8000/examples/demos/composable/index.html' && python3 -m http.server 8000 --directory ../..",
    "dev": "npm run build:css && storybook dev -p 6006",
    "storybook": "npm run build:css && storybook dev -p 6006",
    "build-storybook": "npm run build:css && storybook build",
    "build:css": "tailwindcss -i src/elements/styles.css -o src/elements/compiled.css --minify && npm run postprocess:css",
    "build:css:watch": "tailwindcss -i src/elements/styles.css -o src/elements/compiled.css --watch",
    "postprocess:css": "node scripts/postprocess-element-css.mjs --self-test && node scripts/postprocess-element-css.mjs",
    "dev:provider": "vite ../../examples/internal/remote-provider --port 6007 --strictPort",
    "dev:host": "vite ../../examples/internal/remote-host --port 6006 --strictPort",
    "test:e2e": "playwright test",
    "test:composer-ivp": "playwright test --config playwright.composer.config.ts",
    "test:slots-ivp": "playwright test --config playwright.slots.config.ts",
    "test:menu-ivp": "playwright test --config playwright.menu.config.ts",
    "test:command-ivp": "playwright test --config playwright.command.config.ts",
    "test:focus-ring": "playwright test --config playwright.focus-ring.config.ts",
    "test:input-mask-ivp": "playwright test --config playwright.input-mask.config.ts",
    "test:message-text-token": "playwright test --config playwright.message-text-token.config.ts",
    "test:content-brand-bleed": "playwright test --config playwright.content-brand-bleed.config.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-solid": "^0.400.0",
    "marked": "^18.0.0",
    "solid-element": "^1.9.1",
    "solid-js": "^1.9.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@angular/ssr": "^22.0.0",
    "@cloudflare/workers-types": "^5.20260810.1",
    "@langchain/core": "^1.2.5",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/openai": "^1.5.6",
    "@mastra/client-js": "^1.38.0",
    "@playwright/test": "^1.60.0",
    "@shikijs/langs": "^4.2.0",
    "@shikijs/themes": "^4.2.0",
    "@solidjs/testing-library": "^0.8.0",
    "@storybook/addon-a11y": "^10.4.2",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-themes": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@sveltejs/kit": "^2.70.2",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-router": "^1.170.25",
    "@tanstack/react-start": "^1.168.42",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser-playwright": "4.1.2",
    "@vitest/coverage-v8": "4.1.2",
    "ai": "^7.0.59",
    "axe-core": "^4.12.1",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "http-server": "^14.1.1",
    "jsdom": "^24.0.0",
    "playwright": "^1.59.1",
    "pngjs": "^6.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "storybook": "^10.3.5",
    "storybook-dark-mode": "^5.0.0",
    "storybook-solidjs-vite": "^10.0.12",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "react": ">=18",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/typography": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "tw-animate-css": {
      "optional": true
    }
  }
}
