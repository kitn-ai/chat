{
  "$schema": "https://ui.kitn.ai/schemas/construct/v1.json",
  "name": "daily-assistant",
  "layout": "fullscreen",
  "provider": {
    "mode": "mock"
  },
  "header": {
    "title": "Assistant",
    "themeToggle": true
  },
  "theme": {
    "mode": "dark"
  },
  "shell": {
    "commandPalette": true,
    "userMenu": {
      "name": "Ada",
      "plan": "Pro"
    }
  },
  "empty": {
    "title": "What can I help with?",
    "description": "Ask anything, or start from a suggestion below."
  },
  "capabilities": {
    "starters": [
      "Draft the Q3 board update",
      "Summarize a document",
      "Compare two options"
    ],
    "attachments": {
      "accept": [
        "image/*",
        "application/pdf"
      ]
    },
    "history": {
      "persistence": "local"
    },
    "conversations": true,
    "reasoning": "full",
    "messageActions": {
      "user": [
        "edit"
      ],
      "assistant": [
        "copy",
        "like",
        "dislike"
      ]
    }
  }
}
