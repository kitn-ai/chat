{
  "$schema": "https://ui.kitn.ai/schemas/construct/v1.json",
  "name": "research-assistant",
  "layout": "fullscreen",
  "provider": {
    "mode": "mock"
  },
  "header": {
    "title": "Research",
    "themeToggle": true
  },
  "theme": {
    "mode": "dark"
  },
  "empty": {
    "title": "What do you want to know?",
    "description": "Answers come back with their sources attached."
  },
  "capabilities": {
    "starters": [
      "How does the wire adapter work?",
      "What are message parts?"
    ],
    "attachments": {
      "accept": [
        "application/pdf"
      ]
    },
    "history": {
      "persistence": "local"
    },
    "conversations": true,
    "reasoning": "full",
    "sources": {
      "strip": true
    },
    "messageActions": {
      "user": [
        "edit"
      ],
      "assistant": [
        "copy",
        "like",
        "dislike"
      ]
    }
  }
}
