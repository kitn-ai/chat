{
  "$schema": "https://ui.kitn.ai/schemas/construct/v1.json",
  "name": "research-assistant",
  "layout": "fullscreen",
  "provider": {
    "mode": "mock"
  },
  "header": {
    "title": "Research"
  },
  "theme": {
    "accent": "#0f766e",
    "mode": "dark"
  },
  "capabilities": {
    "starters": [
      "How does the wire adapter work?",
      "What are message parts?"
    ],
    "attachments": {
      "accept": [
        "application/pdf"
      ]
    },
    "history": {
      "persistence": "local"
    },
    "sources": {
      "strip": true
    },
    "messageActions": {
      "user": [
        "edit"
      ],
      "assistant": [
        "copy",
        "like",
        "dislike"
      ]
    }
  }
}
