{
  "$schema": "https://ui.kitn.ai/schemas/construct/v1.json",
  "name": "app-workspace",
  "layout": "split",
  "provider": {
    "mode": "mock"
  },
  "header": {
    "title": "Workspace",
    "themeToggle": true,
    "actions": [
      {
        "label": "Share",
        "variant": "outline"
      },
      {
        "label": "Deploy",
        "variant": "default"
      }
    ]
  },
  "theme": {
    "mode": "dark"
  },
  "empty": {
    "title": "What should we build?",
    "description": "Describe it, and it takes shape in the work surface beside this chat."
  },
  "workSurface": {
    "kind": "preview",
    "url": "/work-surface.html",
    "chrome": {
      "deviceToggle": true,
      "urlBar": true,
      "openInNewTab": true,
      "expand": true
    }
  },
  "shell": {
    "commandPalette": true,
    "userMenu": {
      "name": "Ada",
      "plan": "Pro"
    }
  },
  "composer": {
    "triggers": {
      "slash": [
        {
          "id": "summarize",
          "label": "summarize",
          "description": "Summarize the thread so far"
        },
        {
          "id": "translate",
          "label": "translate",
          "description": "Translate the last message"
        }
      ],
      "mention": [
        {
          "id": "researcher",
          "label": "researcher",
          "description": "Hands off to the research agent"
        },
        {
          "id": "coder",
          "label": "coder",
          "description": "Hands off to the coding agent"
        }
      ]
    }
  },
  "capabilities": {
    "starters": [
      "Build a landing page for a coffee shop",
      "Make the hero work on mobile"
    ],
    "attachments": {
      "accept": [
        "image/*"
      ]
    },
    "history": {
      "persistence": "local"
    },
    "conversations": true,
    "reasoning": "full",
    "messageActions": {
      "user": [
        "edit"
      ],
      "assistant": [
        "copy",
        "like",
        "dislike"
      ]
    }
  }
}
