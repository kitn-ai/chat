{
  "$schema": "https://ui.kitn.ai/schemas/construct/v1.json",
  "name": "in-app-assistant",
  "layout": "aside",
  "provider": {
    "mode": "mock"
  },
  "header": {
    "title": "Assistant",
    "themeToggle": true
  },
  "theme": {
    "mode": "dark"
  },
  "aside": {
    "position": "end",
    "width": "380px"
  },
  "empty": {
    "title": "What can I help with?",
    "description": "Ask about this page, or anything else."
  },
  "composer": {
    "triggers": {
      "slash": [
        {
          "id": "summarize",
          "label": "summarize",
          "description": "Summarize the thread so far"
        },
        {
          "id": "explain",
          "label": "explain",
          "description": "Explain the current page"
        }
      ],
      "mention": [
        {
          "id": "docs",
          "label": "docs",
          "description": "Search the documentation"
        },
        {
          "id": "support",
          "label": "support",
          "description": "Hand off to a person"
        }
      ]
    }
  },
  "capabilities": {
    "starters": [
      "Deploy payments to production",
      "Check the canary status"
    ],
    "attachments": {
      "accept": [
        "image/*",
        "application/pdf"
      ]
    },
    "history": {
      "persistence": "local"
    },
    "conversations": true,
    "reasoning": "full",
    "messageActions": {
      "user": [
        "edit"
      ],
      "assistant": [
        "copy",
        "like",
        "dislike"
      ]
    }
  }
}
