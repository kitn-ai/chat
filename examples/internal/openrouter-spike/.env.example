# Copy this file to `.env.local` (gitignored) and paste your key after the `=`.
#
# UNPREFIXED on purpose. Vite only inlines VITE_-prefixed vars into client code,
# so this name can never end up in the browser bundle. There is no
# VITE_OPENROUTER_API_KEY and there must never be one.
OPENROUTER_API_KEY=

# Any tool-calling-capable model id. This is the default, and it is the model
# every number in FINDINGS.md was measured against. The leading `~` is real:
# it is OpenRouter's floating-latest alias, and it is cheaper than the pinned
# `deepseek/deepseek-v4-flash`. Swapping this for a frontier model works but
# costs roughly 30x per run.
OPENROUTER_MODEL=~deepseek/deepseek-v4-flash-latest

# Reasoning effort: max | xhigh | high | medium | low | minimal | none, or `off`
# to omit the `reasoning` request field entirely. Models without reasoning
# support ignore it. On the anthropic wire this maps to Anthropic's
# `thinking: { type: "enabled", budget_tokens: 1024 }` instead.
OPENROUTER_REASONING_EFFORT=medium

# Which SSE dialect to speak: auto (default) | openai | anthropic.
#
# `auto` sends an `anthropic/*` model through OpenRouter's Anthropic Skin
# (/api/v1/messages), which is the ONLY way to drive the kit's
# `readAnthropicStream` + `toAnthropicMessages` against a live provider —
# OpenRouter's /chat/completions normalises every model, Anthropic's included,
# onto the OpenAI shape.
#
# Set it explicitly to run the SAME model down both paths and compare. That is
# how you tell an Anthropic-MODEL difference from an Anthropic-WIRE bug, and it
# is what found the reasoning result in FINDINGS.md.
OPENROUTER_WIRE=auto

# ── the second backend ───────────────────────────────────────────────────────
#
# SPIKE_BACKEND=gateway swaps the OpenRouter proxy for the SHIPPED
# `vercel-ai-sdk` route (see server/generated/), which calls Vercel's AI Gateway
# through `streamText()`. Only this key is needed for it; OPENROUTER_MODEL and
# OPENROUTER_WIRE are ignored, because that route pins its own model and re-frames
# its own stream. UNPREFIXED, for the same reason as the one above.
#
# The AI SDK reads this out of the environment ITSELF, inside streamText() —
# grep the route for a key and you find nothing.
AI_GATEWAY_API_KEY=
