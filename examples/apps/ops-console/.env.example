# Copy this file to `.env.local` (gitignored) and paste your key after the `=`.
#
# WITH NO KEY THIS APP STILL RUNS, and it is the mode the clean-room build was
# written in. `/api/chat` streams the console's own scripted turn — hand-built
# OpenAI chat-completions SSE carrying real `kai_approval` / `kai_parameters` /
# `kai_options` / `kai_checklist` tool calls, because the kit's
# `createMockResponder()` still cannot emit a tool call and an ops console is
# nothing but tool calls. The browser code is byte-for-byte the same in both
# modes; the seam is in server/chat.ts. So the only thing a key changes is who
# decides which card to propose.
#
# UNPREFIXED on purpose. Vite only inlines VITE_-prefixed vars into client code,
# so this name can never end up in the browser bundle. There is no
# VITE_OPENROUTER_API_KEY and there must never be one.
OPENROUTER_API_KEY=

# Any chat model OpenRouter serves. OpenRouter normalises every model onto the
# OpenAI chat-completions shape, so `readOpenAIStream` parses all of them.
#
# NOT an `anthropic/*` route. Every card here is a STREAMED tool call, and
# OpenRouter's streamed `tool_calls` argument deltas come back as invalid JSON on
# its Anthropic routes (rung-4 F-21: a stray `}` near the end). The same request
# non-streamed parses fine and OpenAI's streamed deltas parse fine, so it is an
# upstream defect — but on an Anthropic model this app streams prose and never
# produces a single card.
#
# `openai/gpt-4o-mini` is the verified alternate.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# Cost ceiling per reply. Lower than the rung-4 builder's on purpose: the biggest
# thing a reply here carries is a form definition, not a whole HTML page. Too low
# and the tool call is truncated mid-argument, the JSON never parses, and the
# card never appears.
OPENROUTER_MAX_TOKENS=2000
