# Copy this file to `.env.local` (gitignored) and paste your key after the `=`.
#
# WITH NO KEY THIS APP STILL RUNS. `/api/chat` streams frames from the kit's own
# `createMockResponder()` instead of calling a provider, and the browser code is
# byte-for-byte the same in both modes — the seam is in server/chat.ts. So the
# only thing a key changes is who writes the words. Conversations persist in
# localStorage in BOTH modes; the key never touches what is stored.
#
# UNPREFIXED on purpose. Vite only inlines VITE_-prefixed vars into client code,
# so this name can never end up in the browser bundle. There is no
# VITE_OPENROUTER_API_KEY and there must never be one.
OPENROUTER_API_KEY=

# Any chat model OpenRouter serves. The default is cheap and fast; OpenRouter
# normalises every model onto the OpenAI chat-completions shape, so
# `readOpenAIStream` parses all of them.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Cost ceiling per reply.
OPENROUTER_MAX_TOKENS=1000
